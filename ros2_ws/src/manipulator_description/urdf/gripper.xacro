<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gripper" params="parent_link">
    <!-- Gripper Base Joint -->
    <joint name="gripper_base_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <!-- Gripper Base Link -->
    <link name="gripper_base_link">
      <visual>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.03"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.015" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.03"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="0.2" r="0.035" h="0.03"/>
    </link>

    <!-- Left Finger Joint (Prismatic) -->
    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="left_finger_link"/>
      <origin xyz="0 0.018 0.03" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.03" effort="20.0" velocity="0.05"/>
      <dynamics damping="1.0" friction="0.5"/>
    </joint>

    <link name="left_finger_link">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.01 0.05"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.01 0.05"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.05" w="0.015" d="0.01" h="0.05"/>
    </link>

    <!-- Right Finger Joint (Prismatic) -->
    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_base_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0 -0.018 0.03" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.03" effort="20.0" velocity="0.05"/>
      <dynamics damping="1.0" friction="0.5"/>
    </joint>

    <link name="right_finger_link">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.01 0.05"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.01 0.05"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="0.05" w="0.015" d="0.01" h="0.05"/>
    </link>

    <!-- Tool Center Point (TCP) / Grasp frame -->
    <joint name="tcp_joint" type="fixed">
      <parent link="gripper_base_link"/>
      <child link="tcp_link"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </joint>
    <link name="tcp_link"/>

  </xacro:macro>

</robot>

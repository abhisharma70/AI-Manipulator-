<?xml version="1.0"?>
<robot name="manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include sub-xacros relative to this file -->
  <xacro:include filename="common_macros.xacro" />
  <xacro:include filename="camera.xacro" />
  <xacro:include filename="gripper.xacro" />
  <xacro:include filename="ros2_control.xacro" />

  <!-- World / Base Footprint -->
  <link name="world"/>

  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="3.0" r="0.1" h="0.05"/>
  </link>

  <!-- Joint 1: Base Yaw Rotation -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="50.0" velocity="2.0"/>
    <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- Link 1 -->
  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.1"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.06" length="0.1"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="2.0" r="0.06" h="0.1"/>
  </link>

  <!-- Joint 2: Shoulder Pitch -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="80.0" velocity="1.5"/>
    <dynamics damping="1.5" friction="0.5"/>
  </joint>

  <!-- Link 2: Upper Arm -->
  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.3"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.3"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="2.5" r="0.045" h="0.3"/>
  </link>

  <!-- Joint 3: Elbow Pitch -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi*0.75}" upper="${pi*0.75}" effort="60.0" velocity="1.5"/>
    <dynamics damping="1.0" friction="0.4"/>
  </joint>

  <!-- Link 3: Forearm -->
  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.25"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.25"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="1.8" r="0.04" h="0.25"/>
  </link>

  <!-- Joint 4: Wrist Pitch -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi*0.75}" upper="${pi*0.75}" effort="30.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.2"/>
  </joint>

  <!-- Link 4: Wrist -->
  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.8" r="0.035" h="0.06"/>
  </link>

  <!-- Joint 5: Wrist Roll -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="wrist_roll_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="20.0" velocity="2.5"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <link name="wrist_roll_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="0.4" r="0.03" h="0.04"/>
  </link>

  <!-- Attach Camera to link_4 (or wrist) -->
  <xacro:camera_sensor parent_link="link_4"/>

  <!-- Attach Gripper to wrist_roll_link -->
  <xacro:gripper parent_link="wrist_roll_link"/>

  <xacro:arg name="controllers_yaml" default="" />

  <!-- Instantiate ros2_control configuration -->
  <xacro:manipulator_ros2_control name="ManipulatorHardwareInterface"/>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <xacro:if value="${'$(arg controllers_yaml)' != ''}">
        <parameters>$(arg controllers_yaml)</parameters>
      </xacro:if>
    </plugin>
  </gazebo>

</robot>

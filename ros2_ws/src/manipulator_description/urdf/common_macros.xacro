<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Materials -->
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.42 0.04 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <!-- Inertia Helper Macros -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 ${h/2}" rpy="0 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
               izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m w d h">
    <inertial>
      <origin xyz="0 0 ${h/2}" rpy="0 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (d*d + h*h)}" ixy="0" ixz="0"
               iyy="${(m/12) * (w*w + h*h)}" iyz="0"
               izz="${(m/12) * (w*w + d*d)}"/>
    </inertial>
  </xacro:macro>

</robot>

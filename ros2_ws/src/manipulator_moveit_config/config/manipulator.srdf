<?xml version="1.0" encoding="UTF-8"?>
<robot name="manipulator">

  <!-- Planning Groups -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp_link" />
  </group>

  <group name="gripper">
    <link name="gripper_base_link" />
    <link name="left_finger_link" />
    <link name="right_finger_link" />
    <joint name="left_finger_joint" />
    <joint name="right_finger_joint" />
  </group>

  <!-- End-Effector Tag -->
  <end_effector name="gripper_ee" parent_link="tcp_link" group="gripper" parent_group="arm" />

  <!-- Named States (Poses) -->
  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.0" />
    <joint name="joint_2" value="0.0" />
    <joint name="joint_3" value="0.0" />
    <joint name="joint_4" value="0.0" />
    <joint name="joint_5" value="0.0" />
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint_1" value="0.0" />
    <joint name="joint_2" value="0.5" />
    <joint name="joint_3" value="0.8" />
    <joint name="joint_4" value="-1.3" />
    <joint name="joint_5" value="0.0" />
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.025" />
    <joint name="right_finger_joint" value="0.025" />
  </group_state>

  <group_state name="close" group="gripper">
    <joint name="left_finger_joint" value="0.0" />
    <joint name="right_finger_joint" value="0.0" />
  </group_state>

  <!-- Disable Collisions Between Adjacent Links -->
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent" />
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent" />
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent" />
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent" />
  <disable_collisions link1="link_4" link2="camera_link" reason="Adjacent" />
  <disable_collisions link1="link_4" link2="wrist_roll_link" reason="Adjacent" />
  <disable_collisions link1="wrist_roll_link" link2="gripper_base_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent" />
  <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent" />
  <disable_collisions link1="camera_link" link2="wrist_roll_link" reason="Never" />
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never" />

</robot>
